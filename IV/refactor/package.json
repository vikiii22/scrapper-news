{
  "name": "tulotero-refactor",
  "private": true,
  "version": "1.0.0",
  "description": "TypeScript reconstruction of the minified Tulotero Angular chunk",
  "scripts": {
    "start": "node demo/build.mjs --serve",
    "build:demo": "node demo/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:provenance": "node verify/provenance.mjs",
    "verify:live": "node verify/build.mjs && node verify/dist/live-matches.mjs"
  },
  "devDependencies": {
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/router": "^19.2.0",
    "acorn": "^8.14.0",
    "esbuild": "^0.25.0",
    "rxjs": "^7.8.1",
    "typescript": "^5.6.3",
    "zone.js": "^0.15.0"
  }
}
